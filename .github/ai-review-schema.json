{
  "type": "object",
  "required": ["detected_count", "findings"],
  "properties": {
    "detected_count": { "type": "integer", "minimum": 0 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "severity", "file", "line", "issue", "suggestion"],
        "properties": {
          "rule_id": { "type": "string" },
          "severity": { "type": "string", "enum": ["high", "medium"] },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "issue": { "type": "string" },
          "suggestion": { "type": "string" }
        }
      }
    }
  }
}
