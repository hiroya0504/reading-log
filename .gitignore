# Review harness run artifacts. Kept out of git so PR diffs stay readable and, more importantly,
# so `git status` stays clean — the reviewers inspect the working tree and a dirty status would
# mislead them. They persist locally, which is what the tuning loop reads.
.review/

# Python bytecode (scripts/review_metrics.py)
__pycache__/
